# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Provisioned by AI Studio for Google Maps Platform.
VITE_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_API_KEY=""

# FIREBASE SERVICE ACCOUNT (Server-side ONLY - never prefix with VITE_ or commit real keys)
# Option 1 (Recommended for Vercel): Paste the full JSON string from Firebase Console -> Service Accounts
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Option 2: Or provide the 3 individual fields from the downloaded service account JSON
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

